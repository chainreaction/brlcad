diff --git a/src/libbu/CMakeLists.txt b/src/libbu/CMakeLists.txt
index b8ab0c0571..143adfe1ec 100644
--- a/src/libbu/CMakeLists.txt
+++ b/src/libbu/CMakeLists.txt
@@ -153,6 +153,20 @@ set(
   ${M_LIBRARY}
 )
 
+# Termux: bionic's <sys/shm.h> redirects shmget/shmat to libandroid_shm*
+# symbols provided by libandroid-shmem.
+find_library(ANDROID_SHMEM_LIBRARY android-shmem)
+if(ANDROID_SHMEM_LIBRARY)
+  list(APPEND BU_PRIVATE_LIBS ${ANDROID_SHMEM_LIBRARY})
+endif(ANDROID_SHMEM_LIBRARY)
+
+# Termux/bionic: libm is a separate library and is NOT part of the default
+# link (unlike glibc >= 2.34, where most math moved into libc).  Upstream
+# moved the former BU_LIBS over to PRIVATE_LIBS, so consumers of libbu such as
+# src/util no longer inherit -lm and fail with "undefined symbol: modf".
+# Expose libm to libbu consumers again.
+set(BU_PUBLIC_LIBS m)
+
 # Include directories needed by libbu users
 set(BU_INCLUDE_DIRS ${BRLCAD_BINARY_DIR}/include ${BRLCAD_SOURCE_DIR}/include)
 
@@ -160,6 +174,7 @@ set(BU_INCLUDE_DIRS ${BRLCAD_BINARY_DIR}/include ${BRLCAD_SOURCE_DIR}/include)
 set(BU_LOCAL_INCLUDE_DIRS ${BSON_INCLUDE_DIR} ${LMDB_INCLUDE_DIR} ${UUID_INCLUDE_DIR})
 
 brlcad_addlib(libbu "${LIBBU_SOURCES}" "${BU_INCLUDE_DIRS}" "${BU_LOCAL_INCLUDE_DIRS}"
+  PUBLIC_LIBS ${BU_PUBLIC_LIBS}
   PRIVATE_LIBS ${BU_PRIVATE_LIBS}
   UNITY_BUILD_SKIP
   backtrace.c
diff --git a/src/libbu/semaphore.c b/src/libbu/semaphore.c
index 5279c4b2e7..f11e36c39b 100644
--- a/src/libbu/semaphore.c
+++ b/src/libbu/semaphore.c
@@ -88,7 +88,12 @@ static mutext_t bu_init_lock = SEMAPHORE_INIT;
 struct bu_semaphores {
     uint32_t magic;
     pthread_mutex_t mu;
-};
+} __attribute__((aligned(8)));
+/* Termux/bionic: pthread_mutex_t only has 4-byte alignment, so
+ * struct bu_semaphores ends up 4-byte aligned.  BU_CKMAG()/
+ * BU_CK_MAGIC() require pointer alignment, so every
+ * bu_semaphore_acquire() on an odd index trips a spurious
+ * "mis-aligned" fatal error.  Force 8-byte alignment. */
 
 static pthread_mutex_t bu_init_lock = SEMAPHORE_INIT;
 #  define DEFINED_BU_SEMAPHORES 1
